APP_ENV=local
DEBUG=true

SAFE_MIGRATIONS=true

DATABASE_DEFAULT_DRIVER=default
# From host: 127.0.0.1:3366. In Docker: DSN overridden in compose to mysql:3306 (local network).
# Create DB if missing: mysql -h 127.0.0.1 -P 3366 -u root -proot -e "CREATE DATABASE IF NOT EXISTS app_sandbox;"
DATABASE_DEFAULT_DSN=mysql://root:root@127.0.0.1:3366/app_sandbox
