{
    "name": "spiral/charset-app",
    "type": "project",
    "description": "Minimal Spiral app to reproduce Cycle ORM charset/collation migration bug",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "cycle/database": "^2.13.0",
        "cycle/migrations": "^4.2.5",
        "cycle/orm": "~2.9.3",
        "cycle/schema-builder": "^2.11.1",
        "doctrine/collections": "^1.8",
        "gam6itko/cycle-nyholm-dsn-bridge": "^0.1.0",
        "spiral/cycle-bridge": "^2.5",
        "spiral/framework": "^3.9",
        "spiral/nyholm-bridge": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "spiral/composer-publish-plugin": true
        },
        "platform": {
            "php": "8.3.22"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
